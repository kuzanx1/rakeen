require "securerandom"
require "base64"
require "tmpdir"
require "fileutils"

default_platform(:ios)

# Real, standard Fastlane CI pattern for building and uploading to
# TestFlight from a machine with no interactive Apple ID session (a
# GitHub Actions macOS runner, or any cloud Mac) -- no 2FA prompt, no
# manual Xcode signing UI, because it authenticates with an App Store
# Connect API key (JWT-based, made for exactly this) instead of an Apple
# ID + password, and imports a real distribution certificate +
# provisioning profile into a scratch keychain rather than relying on
# whatever's already on the machine.
#
# Every secret this lane needs comes from environment variables -- set
# as GitHub Actions repository secrets, never committed here. See
# docs/react-native-migration/testflight-release-checklist.md for the
# exact list and how to obtain each one.
platform :ios do
  desc "Build and upload a real TestFlight build -- no local Mac required, run from CI"
  lane :beta do
    keychain_name = "rakeenpos-ci.keychain-db"
    keychain_password = SecureRandom.uuid

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
    )

    cert_path = File.join(Dir.tmpdir, "rakeenpos-distribution.p12")
    File.binwrite(cert_path, Base64.decode64(ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_BASE64")))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"),
      keychain_name: keychain_name,
      keychain_password: keychain_password,
    )

    # Standard shell-level install (no single dedicated fastlane action
    # for "install a raw .mobileprovision" -- this is the widely
    # documented approach every real CI setup without `match` uses):
    # decode the profile's signed plist to find its real UUID, then copy
    # it into the one location (~/Library/MobileDevice/Provisioning
    # Profiles/<uuid>.mobileprovision) Xcode actually reads profiles from.
    profile_path = File.join(Dir.tmpdir, "rakeenpos-appstore.mobileprovision")
    File.binwrite(profile_path, Base64.decode64(ENV.fetch("IOS_PROVISIONING_PROFILE_BASE64")))
    profile_uuid = sh(
      "security cms -D -i '#{profile_path}' | plutil -extract UUID xml1 -o - - | sed -n 's/.*<string>\\(.*\\)<\\/string>.*/\\1/p'"
    ).strip
    profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(profiles_dir)
    FileUtils.cp(profile_path, File.join(profiles_dir, "#{profile_uuid}.mobileprovision"))

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )

    build_app(
      workspace: "RakeenPOC.xcworkspace",
      scheme: "RakeenPOC",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "RakeenPOC.ipa",
      export_options: {
        provisioningProfiles: {
          "com.rakeen.pos" => profile_uuid,
        },
      },
      xcargs: "DEVELOPMENT_TEAM=7ZZ8RKB973",
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/RakeenPOC.ipa",
      skip_waiting_for_build_processing: true,
    )

    delete_keychain(name: keychain_name)
  end
end

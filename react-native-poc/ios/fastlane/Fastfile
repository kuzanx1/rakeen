require "securerandom"
require "base64"
require "tmpdir"
require "fileutils"

default_platform(:ios)

# Real, standard Fastlane CI pattern for building and uploading to
# TestFlight from a machine with no interactive Apple ID session (a
# GitHub Actions macOS runner, or any cloud Mac) -- no 2FA prompt, no
# manual Xcode signing UI, because it authenticates with an App Store
# Connect API key (JWT-based, made for exactly this) instead of an Apple
# ID + password, and imports a real distribution certificate +
# provisioning profile into a scratch keychain rather than relying on
# whatever's already on the machine.
#
# Every secret this lane needs comes from environment variables -- set
# as GitHub Actions repository secrets, never committed here. See
# docs/react-native-migration/testflight-release-checklist.md for the
# exact list and how to obtain each one.
platform :ios do
  desc "Build and upload a real TestFlight build -- no local Mac required, run from CI"
  lane :beta do
    keychain_name = "rakeenpos-ci.keychain-db"
    keychain_password = SecureRandom.uuid

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
    )

    cert_path = File.join(Dir.tmpdir, "rakeenpos-distribution.p12")
    File.binwrite(cert_path, Base64.decode64(ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_BASE64")))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV.fetch("IOS_DISTRIBUTION_CERTIFICATE_PASSWORD"),
      keychain_name: keychain_name,
      keychain_password: keychain_password,
    )

    # Standard shell-level install (no single dedicated fastlane action
    # for "install a raw .mobileprovision" -- this is the widely
    # documented approach every real CI setup without `match` uses):
    # decode the profile's signed plist to find its real UUID, then copy
    # it into the one location (~/Library/MobileDevice/Provisioning
    # Profiles/<uuid>.mobileprovision) Xcode actually reads profiles from.
    profile_path = File.join(Dir.tmpdir, "rakeenpos-appstore.mobileprovision")
    File.binwrite(profile_path, Base64.decode64(ENV.fetch("IOS_PROVISIONING_PROFILE_BASE64")))
    profile_uuid = sh(
      "security cms -D -i '#{profile_path}' | plutil -extract UUID xml1 -o - - | sed -n 's/.*<string>\\(.*\\)<\\/string>.*/\\1/p'"
    ).strip
    profiles_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
    FileUtils.mkdir_p(profiles_dir)
    FileUtils.cp(profile_path, File.join(profiles_dir, "#{profile_uuid}.mobileprovision"))

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )

    # CURRENT_PROJECT_VERSION is a hardcoded 9 in the pbxproj, so every run
    # archived the SAME build number and App Store Connect rejected the
    # upload: "The bundle version must be higher than the previously
    # uploaded version: '9'" -- after a full, successful 6-minute archive.
    # Asking TestFlight what it actually has and adding one is
    # self-correcting: it needs no commit to bump, it cannot drift from
    # reality, and it stays right even if a build is uploaded from
    # somewhere else. initial_build_number covers the app having no builds
    # at all yet, where the action would otherwise raise.
    # But a build uploaded minutes ago is not listed yet (Apple is still
    # processing it), so two runs close together (#77 then #78, 9 min apart)
    # both read the same number and the second upload is rejected. The
    # workflow's run number is unique and only grows, so it is the floor:
    # every run gets its own number even when TestFlight lags.
    run_floor = ENV["GITHUB_RUN_NUMBER"].to_i + 100
    build_number = [latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.rakeen.pos",
      initial_build_number: 0,
    ) + 1, run_floor].max
    UI.message("Archiving as build #{build_number}")

    # Same self-correcting idea for the version (MARKETING_VERSION). Once
    # Apple approves a version its "train" closes and every later upload
    # under it is rejected -- after the full archive (#80, #81 on 1.5). The
    # version used to be bumped by hand in the pbxproj and was forgotten.
    # Now: take the pbxproj version, and if App Store Connect already has
    # that version (or a higher one) approved/released, use the next minor
    # above the highest closed one. Any API hiccup falls back to the
    # pbxproj version, i.e. the old behaviour.
    # Lanes may run from ios/ or ios/fastlane/ -- look in both.
    pbx_path = ["RakeenPOC.xcodeproj/project.pbxproj", "../RakeenPOC.xcodeproj/project.pbxproj"].find { |p| File.exist?(p) }
    marketing_version = pbx_path && File.read(pbx_path)[/MARKETING_VERSION = ([0-9.]+);/, 1]
    begin
      raise "no MARKETING_VERSION in the pbxproj" unless marketing_version
      closed_states = %w[
        PENDING_DEVELOPER_RELEASE PENDING_APPLE_RELEASE PROCESSING_FOR_APP_STORE READY_FOR_SALE
        REPLACED_WITH_NEW_VERSION REMOVED_FROM_SALE DEVELOPER_REMOVED_FROM_SALE
        ACCEPTED READY_FOR_DISTRIBUTION PROCESSING_FOR_DISTRIBUTION PENDING_APPLE_RELEASE
      ]
      app = Spaceship::ConnectAPI::App.find("com.rakeen.pos")
      closed = app.get_app_store_versions(limit: 50).select do |v|
        state = (v.respond_to?(:app_version_state) && v.app_version_state) || v.app_store_state
        closed_states.include?(state.to_s)
      end.map(&:version_string)
      highest = closed.max_by { |s| Gem::Version.new(s) }
      if highest && Gem::Version.new(marketing_version) <= Gem::Version.new(highest)
        major, minor = highest.split(".").map(&:to_i)
        bumped = "#{major}.#{minor.to_i + 1}"
        UI.important("Version #{marketing_version} is closed on App Store Connect (highest approved: #{highest}) -- uploading as #{bumped}")
        marketing_version = bumped
      end
    rescue StandardError => e
      UI.important("Could not check App Store versions (#{e.class}: #{e.message}); keeping #{marketing_version}")
    end
    UI.message("Version #{marketing_version} (#{build_number})")

    build_app(
      workspace: "RakeenPOC.xcworkspace",
      scheme: "RakeenPOC",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "RakeenPOC.ipa",
      export_options: {
        provisioningProfiles: {
          "com.rakeen.pos" => profile_uuid,
        },
      },
      # CODE_SIGN_STYLE is still "Automatic" in the pbxproj (set when there
      # was no real cert yet, and left that way since Automatic is also
      # what a local Xcode/Apple ID session would want). Automatic signing
      # requires a signed-in Apple ID inside Xcode to resolve/generate a
      # profile -- there is none on a CI runner, so archiving needs these
      # overrides to force manual signing with the exact cert + profile
      # this lane already imported, or `xcodebuild archive` fails with
      # "No profiles for 'com.rakeen.pos' were found" even though the
      # right profile is sitting right there in ~/Library/MobileDevice.
      xcargs: "DEVELOPMENT_TEAM=7ZZ8RKB973 CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=\"Apple Distribution\" PROVISIONING_PROFILE_SPECIFIER=#{profile_uuid} CURRENT_PROJECT_VERSION=#{build_number}#{marketing_version ? " MARKETING_VERSION=#{marketing_version}" : ""}",
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: "./build/RakeenPOC.ipa",
      skip_waiting_for_build_processing: true,
    )

    delete_keychain(name: keychain_name)
  end
end

# Real Android release signing -- copy this file to keystore.properties
# (gitignored, never commit the real one) in this same directory
# (react-native-poc/android/) once you have a real release keystore.
#
# Generate one with (run from react-native-poc/android/app/):
#   keytool -genkeypair -v -storetype PKCS12 -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias rakeenpos-release -keystore rakeenpos-release.keystore
#
# Keep the resulting .keystore file and both passwords somewhere safe and
# durable (e.g. a password manager) outside this repo -- losing them means
# you can never publish an update to an app already live on Google Play
# under this applicationId; there is no recovery process.
storeFile=rakeenpos-release.keystore
storePassword=REPLACE_WITH_REAL_STORE_PASSWORD
keyAlias=rakeenpos-release
keyPassword=REPLACE_WITH_REAL_KEY_PASSWORD
